import { useMemo, useState } from 'react';
import { useNavigate, useParams } from 'react-router-dom';
import { Search, Plus, PawPrint, Milk, Stethoscope, Syringe, Wallet, QrCode, ChevronRight, Tag } from 'lucide-react';
import { useApp } from '../context/AppContext';
import { PhotoManager } from './PhotoManager';
import { AuthedShell } from '../components/layout';
import {
  Card, EmptyState, SkeletonList, Button, TextInput, Select,
  StatusPill, Badge,
} from '../components/ui';
import { useRemoteData } from '../lib/useRemoteData';
import { AnimalsApi, MilkApi, HealthApi, BreedingApi } from '../lib/api';
import { ageFromDOB, formatDate, formatLiters } from '../lib/format';
import { ErrorBanner } from './Home';
import { API_BASE_URL } from '../lib/httpClient';

export function FarmListScreen() {
  const navigate = useNavigate();
  const [search, setSearch] = useState('');
  const [status, setStatus] = useState('active');
  const { data, loading, error, reload } = useRemoteData(() => AnimalsApi.list());

  const animals = data?.animals || [];
  const filtered = useMemo(
    () =>
      animals.filter((a) => {
        const matchesSearch = !search || a.name.toLowerCase().includes(search.toLowerCase()) || a.tagNumber.toLowerCase().includes(search.toLowerCase());
        const matchesStatus = status === 'all' || a.status === status;
        return matchesSearch && matchesStatus;
      }),
    [animals, search, status],
  );

  return (
    <AuthedShell
      title="My Farm"
      right={
        <button onClick={() => navigate('/farm/new')} className="rounded-full bg-emerald-700 p-2 text-white active:scale-95">
          <Plus className="h-4.5 w-4.5" />
        </button>
      }
    >
      <div className="space-y-4">
        <div className="grid grid-cols-5 gap-2 md:mx-auto md:max-w-2xl md:gap-4">
          <ShortcutButton icon={Milk} label="Milk" onClick={() => navigate('/farm/milk')} />
          <ShortcutButton icon={Stethoscope} label="Health" onClick={() => navigate('/farm/health')} />
          <ShortcutButton icon={Syringe} label="Breeding" onClick={() => navigate('/farm/breeding')} />
          <ShortcutButton icon={Wallet} label="Finance" onClick={() => navigate('/farm/finance')} />
          <ShortcutButton icon={Tag} label="Sold" onClick={() => setStatus('sold')} />
        </div>

        <div className="flex gap-2">
          <div className="relative flex-1">
            <Search className="pointer-events-none absolute left-3 top-1/2 h-4 w-4 -translate-y-1/2 text-slate-400" />
            <TextInput placeholder="Search by name or tag" className="pl-9" value={search} onChange={(e) => setSearch(e.target.value)} />
          </div>
          <Select className="w-32" value={status} onChange={(e) => setStatus(e.target.value)}>
            <option value="active">Active</option>
            <option value="sold">Sold</option>
            <option value="deceased">Deceased</option>
            <option value="all">All</option>
          </Select>
        </div>

        {error && <ErrorBanner message={error} onRetry={reload} />}
        {loading && <SkeletonList rows={4} />}

        {!loading && filtered.length === 0 && (
          <EmptyState
            icon={<PawPrint className="h-6 w-6" />}
            title={animals.length === 0 ? 'No animals registered yet' : 'No animals match your search'}
            description={animals.length === 0 ? 'Register your first animal to start tracking milk, health and breeding records.' : 'Try a different search term or filter.'}
            action={animals.length === 0 ? <Button onClick={() => navigate('/farm/new')}>Register an animal</Button> : undefined}
          />
        )}

        <div className="space-y-2.5 md:grid md:grid-cols-2 md:gap-3 md:space-y-0 lg:grid-cols-3">
          {filtered.map((a) => (
            <Card key={a.id} onClick={() => navigate(`/farm/${a.id}`)} className="flex items-center gap-3">
              <div className="flex h-12 w-12 shrink-0 items-center justify-center rounded-xl bg-emerald-50 text-emerald-700">
                <PawPrint className="h-6 w-6" />
              </div>
              <div className="min-w-0 flex-1">
                <div className="flex items-center gap-2">
                  <p className="truncate text-sm font-bold text-slate-900">{a.name}</p>
                  <StatusPill status={a.status} />
                </div>
                <p className="mt-0.5 text-xs text-slate-500">{a.tagNumber} · {a.breed} · {ageFromDOB(a.dateOfBirth)}</p>
              </div>
              <ChevronRight className="h-4 w-4 shrink-0 text-slate-300" />
            </Card>
          ))}
        </div>
      </div>
    </AuthedShell>
  );
}

function ShortcutButton({ icon: Icon, label, onClick }: { icon: typeof Milk; label: string; onClick: () => void }) {
  return (
    <button onClick={onClick} className="flex flex-col items-center gap-1.5 rounded-xl border border-slate-200 bg-white py-3 active:scale-95">
      <Icon className="h-4.5 w-4.5 text-emerald-700" />
      <span className="text-[11px] font-semibold text-slate-600">{label}</span>
    </button>
  );
}

export function AnimalDetailScreen() {
  const { id } = useParams();
  const navigate = useNavigate();
  const { user } = useApp();
  const animalId = Number(id);
  const [tab, setTab] = useState<'overview' | 'milk' | 'health' | 'breeding'>('overview');

  const { data: animalData, loading, error, reload } = useRemoteData(() => AnimalsApi.get(animalId), [animalId]);
  const { data: milkData } = useRemoteData(() => MilkApi.list({ animalId }), [animalId]);
  const { data: healthData } = useRemoteData(() => HealthApi.list({ animalId }), [animalId]);
  const { data: breedingData } = useRemoteData(() => BreedingApi.list({ animalId }), [animalId]);

  const animal = animalData?.animal;

  if (loading) return <AuthedShell title="Animal" showBack><SkeletonList rows={3} /></AuthedShell>;
  if (error) return <AuthedShell title="Animal" showBack><ErrorBanner message={error} onRetry={reload} /></AuthedShell>;
  if (!animal) return <AuthedShell title="Animal" showBack><EmptyState title="Animal not found" description="This record may have been removed or you may not have access to it." /></AuthedShell>;

  return (
    <AuthedShell title={animal.name} showBack>
      <div className="space-y-4">
        <Card className="flex items-center gap-3">
          <div className="flex h-16 w-16 shrink-0 items-center justify-center rounded-2xl bg-emerald-50 text-emerald-700">
            {animal.photos && animal.photos[0] ? <img src={API_BASE_URL.replace(/\/api$/, '') + animal.photos[0].url} alt="" className="h-16 w-16 rounded-2xl object-cover" /> : <PawPrint className="h-8 w-8" />}
          </div>
          <div className="min-w-0 flex-1">
            <div className="flex items-center gap-2">
              <p className="text-base font-bold text-slate-900">{animal.name}</p>
              <StatusPill status={animal.status} />
            </div>
            <p className="text-xs text-slate-500">{animal.tagNumber} · {animal.breed} · {animal.gender}</p>
            <p className="text-xs text-slate-500">{ageFromDOB(animal.dateOfBirth)} old</p>
          </div>
        </Card>

        <Button variant="secondary" fullWidth onClick={() => navigate(`/passport/${animal.agripulseId || animal.id}`)}>
          <QrCode className="h-4 w-4" /> View digital passport & QR code
        </Button>

        {user?.role === 'admin' && (
          <Button variant="outline" fullWidth onClick={() => navigate(`/farm/${animal.id}/edit`)}>Edit animal</Button>
        )}

        <PhotoManager animal={animal} canEdit={user?.role === 'admin'} onChanged={reload} />

        <div className="flex gap-1 rounded-xl bg-slate-100 p-1">
          {(['overview', 'milk', 'health', 'breeding'] as const).map((t) => (
            <button
              key={t}
              onClick={() => setTab(t)}
              className={`flex-1 rounded-lg py-2 text-xs font-bold capitalize transition ${tab === t ? 'bg-white text-emerald-800 shadow-sm' : 'text-slate-500'}`}
            >
              {t}
            </button>
          ))}
        </div>

        {tab === 'overview' && (
          <Card className="space-y-2 text-sm">
            <Row label="Category" value={animal.category ? animal.category.replace('_', ' ') : '—'} />
            <Row label="Colour" value={animal.color || '—'} />
            <Row label="AgriPulse ID" value={animal.agripulseId || 'Not yet issued'} />
            <Row label="Registered" value={formatDate(animal.createdAt)} />
            <Row label="Notes" value={animal.notes || '—'} />
          </Card>
        )}

        {tab === 'milk' && (
          <div className="space-y-2.5">
            {(milkData?.records.length || 0) === 0 ? (
              <EmptyState title="No milk records" description="Milk production entries for this animal will appear here." />
            ) : (
              milkData!.records.map((m) => (
                <Card key={m.id} className="flex items-center justify-between">
                  <span className="text-sm text-slate-700">{formatDate(m.productionDate)}</span>
                  <span className="text-sm font-bold text-slate-900">{formatLiters(m.quantityLiters)}</span>
                </Card>
              ))
            )}
          </div>
        )}

        {tab === 'health' && (
          <div className="space-y-2.5">
            {(healthData?.records.length || 0) === 0 ? (
              <EmptyState title="No health records" description="Treatments, vaccinations and vet visits will appear here." />
            ) : (
              healthData!.records.map((h) => (
                <Card key={h.id}>
                  <p className="text-sm font-semibold text-slate-900">{h.condition}</p>
                  <p className="mt-0.5 text-xs text-slate-500">{formatDate(h.recordDate)}{h.doctorName ? ` · ${h.doctorName}` : ''}</p>
                  {h.treatment && <p className="mt-1 text-xs text-slate-600">Treatment: {h.treatment}</p>}
                  {h.vaccination && <Badge tone="info">Vaccination: {h.vaccination}</Badge>}
                </Card>
              ))
            )}
          </div>
        )}

        {tab === 'breeding' && (
          <div className="space-y-2.5">
            {(breedingData?.records.length || 0) === 0 ? (
              <EmptyState title="No breeding records" description="Service dates, pregnancy status and calving records will appear here." />
            ) : (
              breedingData!.records.map((b) => (
                <Card key={b.id}>
                  <div className="flex items-center justify-between">
                    <p className="text-sm font-semibold text-slate-900">Service: {formatDate(b.serviceDate)}</p>
                    <StatusPill status={b.pregnancyStatus} />
                  </div>
                  {b.expectedBirthDate && <p className="mt-1 text-xs text-slate-500">Expected birth: {formatDate(b.expectedBirthDate)}</p>}
                  {b.bullName && <p className="text-xs text-slate-500">Sire: {b.bullName}</p>}
                </Card>
              ))
            )}
          </div>
        )}

      </div>
    </AuthedShell>
  );
}

function Row({ label, value }: { label: string; value: string }) {
  return (
    <div className="flex items-start justify-between gap-4 border-b border-slate-100 pb-2 last:border-0 last:pb-0">
      <span className="text-slate-500">{label}</span>
      <span className="text-right font-medium text-slate-800">{value}</span>
    </div>
  );
}
